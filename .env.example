# ═══════════════════════════════════════════════════════════
#  بوت مركز الطحان — متغيرات البيئة
#  انسخ هذا الملف إلى .env ثم املأ القيم
# ═══════════════════════════════════════════════════════════

# ─── إلزامي ───
# توكن بوت تيليغرام من @BotFather
BOT_TOKEN=توكنك_من_@BotFather

# ─── اختياري: التواصل ───
# رقم واتساب بصيغة دولية بدون + ولا مسافات
# الافتراضي: 963999278956
WHATSAPP_NUMBER=963999278956


# ═══════════════════════════════════════════════════════════
#  المساعد الذكي (اختياري)
#  بدون AI_API_KEY يعمل المساعد بمحرك محلي بدون إنترنت.
# ═══════════════════════════════════════════════════════════

# مفتاح مزوّد الذكاء الاصطناعي (OpenAI-compatible)
AI_API_KEY=

# عنوان الـ API (اتركه فارغاً لـ OpenAI)
AI_BASE_URL=https://api.openai.com/v1

# اسم الموديل
AI_MODEL=gpt-4o-mini

# مهلة الطلب بالميلي ثانية
AI_TIMEOUT_MS=20000


# ═══════════════════════════════════════════════════════════
#  البث والإشعارات (اختياري)
#  بدون Upstash تُحفظ الاشتراكات في ذاكرة العملية فقط
#  وتُفقد عند إعادة تشغيل الخادم.
# ═══════════════════════════════════════════════════════════

# Upstash Redis — من لوحة تحكم upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# مفاتيح التخزين (اختياري — لها قيم افتراضية)
TG_SUBS_KEY=tahan:telegram:subs
TG_SENT_KEY=tahan:telegram:last_announcement

# رابط جلب الإعلانات من الموقع (نقطة النهاية موجودة في api/announcement.js)
ANNOUNCEMENT_URL=https://altahhan.vercel.app/api/announcement

# فترة استطلاع الإعلانات بالميلي ثانية (الحد الأدنى 60000)
ANNOUNCE_POLL_MS=300000


# ═══════════════════════════════════════════════════════════
#  النشر (اختياري)
# ═══════════════════════════════════════════════════════════

# منفذ الخادم (Render يحدده تلقائياً)
PORT=10000
